# ===== 运行时环境变量示例（复制为 .env 并填入真实值；密钥勿提交仓库/论文）=====

# 阿里云百炼（Qwen）OpenAI 兼容接口
QWEN_API_KEY=sk-在这里填你的百炼APIKey
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=text-embedding-v4

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=在这里填你的MySQL密码
MYSQL_DB=course_ta

# Redis（会话存储；未安装 Redis 时自动降级为内存 fakeredis，仅限开发）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
SESSION_TTL=28800
